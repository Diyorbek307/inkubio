# Скопируйте этот файл в .env и заполните.

# Куда приходят заявки (можно несколько через запятую)
MAIL_TO=sales@your-company.com

# SMTP почтового ящика, С КОТОРОГО отправляются письма.
# Gmail:   SMTP_HOST=smtp.gmail.com   SMTP_PORT=465  (нужен «пароль приложения», не обычный пароль)
# Яндекс:  SMTP_HOST=smtp.yandex.ru   SMTP_PORT=465  (пароль приложения в настройках Яндекс ID)
# Mail.ru: SMTP_HOST=smtp.mail.ru     SMTP_PORT=465  (пароль для внешних приложений)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-mailbox@gmail.com
SMTP_PASS=пароль-приложения

# Telegram (необязательно): заявки будут приходить и в чат.
# 1) создайте бота у @BotFather и возьмите токен; 2) напишите боту «/start»;
# 3) chat_id: откройте https://api.telegram.org/bot<ТОКЕН>/getUpdates и найдите "chat":{"id":...}
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# Страница заявок для команды: http://ваш-сайт/admin (логин любой, пароль ниже).
# Пусто — страница выключена.
# Пароль панели управления https://ваш-сайт/admin (статистика, заявки, новости, информация на сайте).
# Без пароля панель выключена. Придумайте длинный: от 12 символов.
# ADMIN_PASSWORD=придумайте-длинный-пароль

# Необязательно:
# MAIL_FROM=your-mailbox@gmail.com   # по умолчанию = SMTP_USER
# PORT=5173                          # порт сайта
# TRUST_PROXY=1                      # если сайт стоит за nginx / хостинг-прокси
# (при запуске через «Запустить сайт.cmd» ставится само: TRUST_PROXY=cloudflare)
